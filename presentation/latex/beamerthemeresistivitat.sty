  \hspace*{0.9cm}\begin{minipage}[t]{\dimexpr\paperwidth-1.8cm\relax}
    {\scriptsize\medium\color{accent}\espaiat{NOTES}\hfill{\color{muted}\insertshortframetitle}}\par\vspace{-0.2em}
    {\color{hairline}\rule{\linewidth}{0.4pt}}\par
    \normalsize\raggedright\color{ink}\insertnote
  \end{minipage}}

% ---------------------------------------------------------------------
%  Tall geològic estilitzat (model conceptual)
%  Coordenades: x in [0,16], y in [0,2.1]; superfície a y = 2.1
%  #1: opcions de TikZ (escala, opacitat...), #2: nombre d'estacions
% ---------------------------------------------------------------------
\newcommand{\rstall}[1][]{%
  \begin{scope}[#1]
    % aqüífer confinat
    \fill[capaC] (0,0) rectangle (16,2.1);
    \fill[pattern={Dots[radius=0.32pt,distance=3.2pt]}, pattern color=rho5!45!black!45]
      (0,0) rectangle (16,0.95);
    % aqüitard (amb discontinuïtat entre x = 10.2 i 11.2)
    \fill[capaB]
      (0,1.52) .. controls (2.5,1.62) and (5,1.40) .. (7.5,1.50)
      .. controls (8.8,1.55) and (9.6,1.45) .. (10.2,1.30)
      .. controls (10.35,1.05) and (10.25,0.98) .. (10.1,0.96)
      .. controls (8.5,0.86) and (6,1.02) .. (3.5,0.90)
      .. controls (2,0.84) and (1,0.95) .. (0,0.92) -- cycle;
    \fill[capaB]
      (11.2,1.32) .. controls (12.5,1.55) and (14.2,1.45) .. (16,1.50)
      -- (16,0.90) .. controls (14.5,0.84) and (12.6,1.00) .. (11.5,0.98)
      .. controls (11.25,0.99) and (11.1,1.10) .. (11.2,1.32) -- cycle;
    \fill[pattern={Lines[angle=0,distance=2.6pt,line width=0.25pt]}, pattern color=rho2!40]
      (0,1.52) .. controls (2.5,1.62) and (5,1.40) .. (7.5,1.50)
      .. controls (8.8,1.55) and (9.6,1.45) .. (10.2,1.30)
      .. controls (10.35,1.05) and (10.25,0.98) .. (10.1,0.96)
      .. controls (8.5,0.86) and (6,1.02) .. (3.5,0.90)
      .. controls (2,0.84) and (1,0.95) .. (0,0.92) -- cycle;
    \fill[pattern={Lines[angle=0,distance=2.6pt,line width=0.25pt]}, pattern color=rho2!40]
      (11.2,1.32) .. controls (12.5,1.55) and (14.2,1.45) .. (16,1.50)
      -- (16,0.90) .. controls (14.5,0.84) and (12.6,1.00) .. (11.5,0.98)
      .. controls (11.25,0.99) and (11.1,1.10) .. (11.2,1.32) -- cycle;
    % aqüífer lliure
    \fill[capaA]
      (0,2.1) -- (16,2.1) -- (16,1.50) .. controls (14.2,1.45) and (12.5,1.55) .. (11.2,1.32)
      .. controls (10.9,1.36) and (10.5,1.36) .. (10.2,1.30)
      .. controls (9.6,1.45) and (8.8,1.55) .. (7.5,1.50)
      .. controls (5,1.40) and (2.5,1.62) .. (0,1.52) -- cycle;
    % límits
    \draw[ink!30, line width=0.35pt]
      (0,1.52) .. controls (2.5,1.62) and (5,1.40) .. (7.5,1.50)
      .. controls (8.8,1.55) and (9.6,1.45) .. (10.2,1.30);
    \draw[ink!30, line width=0.35pt]
      (11.2,1.32) .. controls (12.5,1.55) and (14.2,1.45) .. (16,1.50);
    \draw[ink!30, line width=0.35pt]
      (0,0.92) .. controls (1,0.95) and (2,0.84) .. (3.5,0.90)
      .. controls (6,1.02) and (8.5,0.86) .. (10.1,0.96);
    \draw[ink!30, line width=0.35pt]
      (11.5,0.98) .. controls (12.6,1.00) and (14.5,0.84) .. (16,0.90);
    % ascens d'aigua calenta per la discontinuïtat
    \foreach \dx/\op in {-0.28/0.55, 0/1, 0.28/0.55}{
      \draw[rho2, opacity=\op, line width=0.9pt, -{Stealth[length=3.2pt,width=3pt]}]
        (10.7+\dx,0.12) .. controls (10.7+\dx*1.2,0.7) and (10.7+\dx*0.6,1.1) .. (10.7+\dx*1.6,1.78);
    }
    % superfície
    \draw[ink!70, line width=0.6pt] (0,2.1) -- (16,2.1);
  \end{scope}}

% Marcadors d'estació a la superfície: \rsestacions{x0}{x1}{n}{y}
\newcommand{\rsestacions}[4]{%
  \pgfmathtruncatemacro{\rs@nm}{#3-1}%
  \foreach \i in {0,...,\rs@nm}{
    \pgfmathsetmacro{\xx}{#1+(#2-#1)*\i/(#3-1)}
    \draw[ink, fill=paper, line width=0.45pt]
      (\xx,#4+0.01) -- ++(-0.075,0.13) -- ++(0.15,0) -- cycle;
  }}

% ---------------------------------------------------------------------
%  Portada, separadors de secció i diapositiva final (com a fons)
% ---------------------------------------------------------------------
\def\rs@tutora{}
\newcommand{\tutora}[1]{\def\rs@tutora{#1}}
\def\rs@kicker{}
\newcommand{\kicker}[1]{\def\rs@kicker{#1}}

\newcommand{\rs@colorbarlegend}[2]{% posició (x,y) de l'extrem esquerre
  \begin{scope}[shift={(#1,#2)}]
    \shade[shading=rhobar] (0,0) rectangle (3.6,0.11);
    \foreach \k/\lab in {0/$1$,1/$10$,2/$10^{2}$,3/$10^{3}$,4/$10^{4}$}{
      \draw[ink!60, line width=0.3pt] (0.9*\k,0) -- ++(0,-0.06);
      \node[font=\tiny, text=muted, anchor=north, inner sep=1.5pt] at (0.9*\k,-0.05) {\lab};
    }
    \node[font=\tiny, text=muted, anchor=east, inner sep=2pt] at (0,0.055) {$\rho\ (\Omega{\cdot}\mathrm{m})$};
  \end{scope}}

\newcommand{\rsportadafons}{%
  \begin{tikzpicture}
    \useasboundingbox (0,0) rectangle (\paperwidth,\paperheight);
    \rstall[yscale=1.0]
    \rsestacions{1.0}{15.0}{16}{2.1}
    \node[anchor=north west, inner sep=0] at (0.9,8.45) {\inserttitlegraphic};
    \node[anchor=north east, align=right, inner sep=0, text=muted, font=\scriptsize\medium]
      at (15.1,8.32) {\espaiat{\rs@kicker}};
    \node[anchor=north west, align=left, inner sep=0, text width=13.4cm, text=ink,
          font=\fontsize{19}{24.5}\selectfont\medium] at (0.9,7.08) {\inserttitle};
    \shade[shading=rhobar] (0.9,4.3) rectangle (4.4,4.36);
    \node[anchor=north west, inner sep=0, text=ink, font=\large\medium] at (0.9,4.0) {\insertauthor};
    \node[anchor=north west, inner sep=0, text=ink, font=\small] at (0.9,3.42) {\rs@tutora};
    \node[anchor=north west, inner sep=0, text=muted, font=\footnotesize] at (0.9,2.98) {\insertinstitute};
    \rs@colorbarlegend{11.5}{2.9}
  \end{tikzpicture}}

\newcommand{\rsseccions}{}  % es defineix al document: llista de seccions
\newcommand{\rs@seccolor}[1]{%
  \ifcase#1\or rho3\or rho4\or rho5\or rho6\else rho6\fi}

\newcommand{\rsseccio@fons}{%
  \begin{tikzpicture}
    \useasboundingbox (0,0) rectangle (\paperwidth,\paperheight);
    \fill[nit] (0,0) rectangle (16,9);
    \rstall[opacity=0.22]
    \edef\rs@c{\rs@seccolor{\insertsectionnumber}}
    \node[anchor=south west, inner sep=0, text=\rs@c, font=\fontsize{66}{66}\selectfont\medium]
      at (0.85,4.75) {0\insertsectionnumber};
    \node[anchor=north west, inner sep=0, text=white, font=\fontsize{26}{30}\selectfont\medium]
      at (0.9,4.45) {\insertsectionhead};
    \shade[shading=rhobar] (0.9,3.35) rectangle (4.4,3.41);
    \foreach \nom [count=\n] in \rsseccions {
      \ifnum\n=\insertsectionnumber
        \node[anchor=west, text=white, font=\small\medium, inner sep=0] at (11.0,6.6-0.55*\n) {0\n\hspace{0.8em}\nom};
        \fill[\rs@c] (10.75,6.6-0.55*\n) -- ++(-0.085,0.12) -- ++(0.17,0) -- cycle;
      \else
        \node[anchor=west, text=white!45!nit, font=\small, inner sep=0] at (11.0,6.6-0.55*\n) {0\n\hspace{0.8em}\nom};
      \fi
    }
  \end{tikzpicture}}

\AtBeginSection{%
  {\setbeamertemplate{background}{\rsseccio@fons}%
   \begin{frame}[plain,noframenumbering]\end{frame}}}

\newcommand{\rsfinalfons}{%
