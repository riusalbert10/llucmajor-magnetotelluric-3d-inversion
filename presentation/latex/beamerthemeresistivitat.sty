% =====================================================================
%  beamerthemeresistivitat.sty
%  Tema Beamer "Resistivitat" — pensat per a la defensa del TFG
%  "Inversió geofísica de dades magnetotel·lúriques del reservori
%   geotèrmic de Llucmajor" (Albert Rius Saborit, UIB 2025-2026)
%
%  Idea: la barra de colors de resistivitat (1 -> 10^4 Ohm·m) i els
%  marcadors d'estació (triangle invertit) com a fil conductor visual.
%  Compilar amb XeLaTeX o LuaLaTeX (fonts incloses a ./fonts).
% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeresistivitat}[2026/09/11 Tema Resistivitat]

\RequirePackage{iftex}
\RequirePackage{xcolor}
\RequirePackage{tikz}
\usetikzlibrary{calc,positioning,arrows.meta,patterns.meta,shapes.geometric,shapes.symbols}
\RequirePackage[most]{tcolorbox}
\RequirePackage{booktabs}
\RequirePackage{colortbl}

% ---------------------------------------------------------------------
%  Colors
% ---------------------------------------------------------------------
\definecolor{paper}{HTML}{FAF8F4}
\definecolor{ink}{HTML}{1B2430}
\definecolor{muted}{HTML}{667085}
\definecolor{hairline}{HTML}{DDD8CE}
\definecolor{nit}{HTML}{0E2233}
\definecolor{accent}{HTML}{C2410C}
\definecolor{accent2}{HTML}{1D5FD6}
% escala de resistivitat (conductor -> resistiu), inspirada en les figures del TFG
\definecolor{rho1}{HTML}{7F0000}
\definecolor{rho2}{HTML}{D7191C}
\definecolor{rho3}{HTML}{F46D1F}
\definecolor{rho4}{HTML}{F6C90E}
\definecolor{rho5}{HTML}{8CCB3A}
\definecolor{rho6}{HTML}{22C1D6}
\definecolor{rho7}{HTML}{1D5FD6}
\definecolor{rho8}{HTML}{0A1F7A}
\colorlet{capaA}{rho7!26!paper}   % aqüífer lliure (resistiu)
\colorlet{capaB}{rho3!42!paper}   % aqüitard (conductor)
\colorlet{capaC}{rho5!34!paper}   % aqüífer confinat

% Escala de colors exacta de les figures del TFG (jet invertit), 1 -> 10^4 Ohm·m
\definecolor{cb0}{HTML}{630000}
\definecolor{cb1}{HTML}{FF2200}
\definecolor{cb2}{HTML}{FF9800}
\definecolor{cb3}{HTML}{E1FF16}
\definecolor{cb4}{HTML}{7AFF7D}
\definecolor{cb5}{HTML}{16FFE1}
\definecolor{cb6}{HTML}{0081FF}
\definecolor{cb7}{HTML}{0000FF}
\definecolor{cb8}{HTML}{000063}
% Degradats (TikZ fa servir la franja central 25-75bp)
\pgfdeclarehorizontalshading{rhobar}{100bp}{%
  color(0bp)=(cb0); color(25bp)=(cb0); color(31.25bp)=(cb1); color(37.5bp)=(cb2);
  color(43.75bp)=(cb3); color(50bp)=(cb4); color(56.25bp)=(cb5); color(62.5bp)=(cb6);
  color(68.75bp)=(cb7); color(75bp)=(cb8); color(100bp)=(cb8)}
\pgfdeclareverticalshading{rhobarv}{100bp}{%
  color(0bp)=(cb0); color(25bp)=(cb0); color(31.25bp)=(cb1); color(37.5bp)=(cb2);
  color(43.75bp)=(cb3); color(50bp)=(cb4); color(56.25bp)=(cb5); color(62.5bp)=(cb6);
  color(68.75bp)=(cb7); color(75bp)=(cb8); color(100bp)=(cb8)}

% ---------------------------------------------------------------------
%  Fonts: Poppins (text) + Fira Math (equacions)
% ---------------------------------------------------------------------
\usefonttheme{professionalfonts}
\ifPDFTeX
  \PackageWarningNoLine{beamerthemeresistivitat}{%
    Aquest tema està pensat per a XeLaTeX o LuaLaTeX.\MessageBreak
    Amb pdfLaTeX es faran servir les fonts per defecte}
  \newcommand{\medium}{\bfseries}
  \newcommand{\espaiat}[1]{#1}
\else
  \RequirePackage{fontspec}
  \RequirePackage{unicode-math}
  \defaultfontfeatures{Ligatures=TeX}
  \setsansfont{Poppins}[
    Path            = fonts/ ,
    Extension       = .ttf ,
    UprightFont     = *-Regular ,
    ItalicFont      = *-Italic ,
    BoldFont        = *-Bold ,
    BoldItalicFont  = *-BoldItalic ,
    FontFace        = {l}{n}{*-Light} ,
    FontFace        = {l}{it}{*-LightItalic} ,
    FontFace        = {mb}{n}{*-Medium} ,
    FontFace        = {mb}{it}{*-MediumItalic} ]
  \setmainfont{Poppins}[
    Path = fonts/ , Extension = .ttf ,
    UprightFont = *-Regular , ItalicFont = *-Italic ,
    BoldFont = *-Bold , BoldItalicFont = *-BoldItalic ]
  \setmathfont{FiraMath-Regular.otf}[Path = fonts/]
  \newcommand{\medium}{\fontseries{mb}\selectfont}
  \newcommand{\espaiat}[1]{{\addfontfeatures{LetterSpace=9}#1}}
\fi
\newcommand{\lleuger}{\fontseries{l}\selectfont}

% ---------------------------------------------------------------------
%  Geometria i colors de Beamer
% ---------------------------------------------------------------------
\newlength{\rsmargin}\setlength{\rsmargin}{0.9cm}
\setbeamersize{text margin left=\rsmargin, text margin right=\rsmargin}

\setbeamercolor{normal text}{fg=ink}
\setbeamercolor{background canvas}{bg=paper}
\setbeamercolor{structure}{fg=nit}
\setbeamercolor{alerted text}{fg=accent}
\setbeamercolor{example text}{fg=accent2}
\setbeamercolor{frametitle}{fg=ink}
\setbeamercolor{footline}{fg=muted}
\setbeamercolor{itemize item}{fg=accent}
\setbeamercolor{itemize subitem}{fg=muted}
\setbeamercolor{enumerate item}{fg=accent}
\setbeamercolor{note page}{bg=white,fg=ink}

\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{itemize item}{\raisebox{0.22ex}{\color{accent}\rule{0.40em}{0.40em}}}
\setbeamertemplate{itemize subitem}{\raisebox{0.35ex}{\color{muted}\rule{0.55em}{0.09em}}}
\setbeamertemplate{enumerate item}{{\medium\color{accent}\insertenumlabel.}}
\setbeamertemplate{caption}{\insertcaption}

\setbeamerfont{frametitle}{size=\Large}
\setbeamerfont{footline}{size=\tiny}
\setbeamerfont{note page}{size=\small}

% Espai entre ítems
\newcommand{\rsitemsep}{0.35em}
\addtobeamertemplate{itemize/enumerate body begin}{}{\setlength{\itemsep}{\rsitemsep}}

% ---------------------------------------------------------------------
%  Barra de resistivitat + marcador d'estació (progrés)
% ---------------------------------------------------------------------
\newif\ifrsannex
\newcommand{\annexos}{\appendix\global\rsannextrue}

% \rsbarra{amplada}{alçada}
\newcommand{\rsbarra}[2]{\tikz[baseline=0pt]\shade[shading=rhobar] (0,0) rectangle (#1,#2);}

\newcommand{\rs@progress}{%
  \begin{tikzpicture}
    \pgfmathsetmacro{\rs@w}{(\paperwidth-2*\rsmargin)/1cm}
    \pgfmathsetmacro{\rs@p}{min(1,max(0,(\insertframenumber-1)/max(1,\inserttotalframenumber-1)))}
    \useasboundingbox (0,-0.02) rectangle (\rs@w,0.2);
    \shade[shading=rhobar] (0,0) rectangle (\rs@w,0.035);
    \ifrsannex\else
      \fill[ink] ({\rs@p*\rs@w},0.05) -- ++(-0.085,0.14) -- ++(0.17,0) -- cycle;
    \fi
  \end{tikzpicture}}

% ---------------------------------------------------------------------
%  Títol de diapositiva
% ---------------------------------------------------------------------
\setbeamertemplate{frametitle}{%
  \nointerlineskip
  \begin{beamercolorbox}[wd=\paperwidth,leftskip=\rsmargin,rightskip=\rsmargin,ht=1.05cm,dp=0.16cm]{frametitle}%
    \usebeamerfont{frametitle}\medium\insertframetitle
  \end{beamercolorbox}%
  \nointerlineskip
  \begin{beamercolorbox}[wd=\paperwidth,leftskip=\rsmargin,rightskip=\rsmargin,ht=0.22cm,dp=0.02cm]{frametitle}%
    \rs@progress
  \end{beamercolorbox}%
  \vskip0.12cm
}

% ---------------------------------------------------------------------
%  Peu de pàgina
% ---------------------------------------------------------------------
\setbeamertemplate{footline}{%
  \begin{beamercolorbox}[wd=\paperwidth,ht=0.42cm,dp=0.24cm,leftskip=\rsmargin,rightskip=\rsmargin]{footline}%
