% Etiqueta sense majúscules (per a unitats)
\newcommand{\etiquetams}[2][accent]{{\scriptsize\medium\color{#1}#2}}

% Sense partició de mots i amb espais de display compactes dins les caixes
\AtBeginDocument{\hyphenpenalty=10000\exhyphenpenalty=10000}
\newcommand{\rs@displayskips}{%
  \setlength{\abovedisplayskip}{4pt}\setlength{\belowdisplayskip}{4pt}%
  \setlength{\abovedisplayshortskip}{2pt}\setlength{\belowdisplayshortskip}{4pt}}

% Caixa amb franja lateral: \begin{caixa}[color]{Títol}
\newtcolorbox{caixa}[2][accent]{%
  enhanced, colback=white, colframe=hairline, boxrule=0.4pt, arc=1.6pt,
  borderline west={2.2pt}{0pt}{#1},
  left=7pt, right=6pt, top=2pt, bottom=4pt, boxsep=0pt,
  fontupper=\small, before upper={\raggedright\rs@displayskips},
  title={\etiqueta[#1!85!black]{#2}}, coltitle=#1, colbacktitle=white, halign title=flush left,
  titlerule=0pt, toptitle=4pt, bottomtitle=0pt, lefttitle=7pt}

% Caixa sense títol
\newtcolorbox{nota}[1][accent]{%
  enhanced, colback=white, colframe=hairline, boxrule=0.4pt, arc=1.6pt,
  borderline west={2.2pt}{0pt}{#1},
  left=7pt, right=6pt, top=4pt, bottom=4pt, boxsep=0pt,
  fontupper=\small, before upper=\raggedright}

% Xifra destacada: \xifra[color]{valor}{descripció}
\newcommand{\xifra}[3][accent]{%
  \begin{tcolorbox}[enhanced, colback=white, colframe=hairline, boxrule=0.4pt, arc=1.6pt,
      borderline west={2.2pt}{0pt}{#1}, left=7pt, right=5pt, top=2pt, bottom=3pt, boxsep=0pt,
      before skip=0pt, after skip=5pt, before upper=\raggedright]
    {\fontsize{17}{19}\selectfont\medium\color{#1!88!black}#2}\par\vspace{1pt}
    {\scriptsize\color{muted}#3\par}
  \end{tcolorbox}}

% Figura dins d'una targeta blanca: \figura[amplada]{fitxer}
\newcommand{\figura}[2][\linewidth]{%
  \tcbox[enhanced, colback=white, colframe=hairline, boxrule=0.4pt, arc=1.6pt,
      left=2pt, right=2pt, top=2pt, bottom=2pt, boxsep=0pt, nobeforeafter, tcbox raise base]%
    {\includegraphics[width=\dimexpr#1-4.8pt\relax]{#2}}\par}
% Variant per alçada: \figuraalt{alçada}{fitxer}
\newcommand{\figuraalt}[2]{%
  \tcbox[enhanced, colback=white, colframe=hairline, boxrule=0.4pt, arc=1.6pt,
      left=2pt, right=2pt, top=2pt, bottom=2pt, boxsep=0pt, nobeforeafter]{\includegraphics[height=#1]{#2}}}

% Barra de colors vertical: \rscolorbarv{alçada}
\newcommand{\rscolorbarv}[1]{%
  \begin{tikzpicture}[baseline=(current bounding box.center)]
    \pgfmathsetmacro{\rs@h}{#1/1cm}
    \shade[shading=rhobarv] (0,0) rectangle (0.2,\rs@h);
    \draw[ink!40, line width=0.3pt] (0,0) rectangle (0.2,\rs@h);
    \foreach \k/\lab in {0/$1$,1/$10$,2/$10^{2}$,3/$10^{3}$,4/$10^{4}$}{
      \draw[ink!60, line width=0.3pt] (0.2,{\k*\rs@h/4}) -- ++(0.06,0);
      \node[font=\tiny, text=muted, anchor=west, inner sep=1.5pt] at (0.26,{\k*\rs@h/4}) {\lab};
    }
    \node[font=\tiny, text=muted, rotate=90, anchor=south] at (-0.04,{\rs@h/2}) {$\rho\ (\Omega{\cdot}\mathrm{m})$};
  \end{tikzpicture}}

% Peu de figura / font
\newcommand{\peu}[1]{{\par\vspace{2pt}\raggedright\tiny\color{muted}#1\par}}

